# Copy to `.env` to override the defaults of docker-compose.yml.
API_KEY=dev-api-key
WEBHOOK_SECRET=dev-webhook-secret
LOG_LEVEL=INFO

# Host ports
API_PORT=8000
WEBHOOK_RECEIVER_PORT=9000
RABBITMQ_MANAGEMENT_PORT=15672

# Processing tunables (all settings: app/config.py)
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY=2
# GATEWAY_MIN_DELAY=2
# GATEWAY_MAX_DELAY=5
# GATEWAY_SUCCESS_RATE=0.9
# CONSUMER_PREFETCH_COUNT=10
